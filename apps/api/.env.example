APP_ENV=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://showcasehost:showcasehost@localhost:5432/showcasehost
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=code_chunks
VECTOR_STORE_PROVIDER=qdrant
HF_API_TOKEN=
HF_INFERENCE_URL=https://router.huggingface.co/hf-inference/models
EMBEDDING_PROVIDER=huggingface
EMBEDDING_INPUT_TOKEN_LIMIT=8192
EMBEDDING_RUNNER_ENABLED=true
EMBEDDING_LARGE_REPOSITORY_CHUNKS=2000
EMBEDDING_BATCH_SIZE=32
EMBEDDING_WORKER_CONCURRENCY=4
EMBEDDING_REQUEST_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=4
EMBEDDING_BACKOFF_BASE_SECONDS=1
EMBEDDING_POLL_SECONDS=1
EMBEDDING_LEASE_SECONDS=600
EMBEDDING_MAX_ATTEMPTS=2
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_FALLBACK_MODEL=BAAI/bge-reranker-large
RERANKER_REQUEST_TIMEOUT_SECONDS=60
RERANKER_MAX_RETRIES=2

CHUNKING_RUNNER_ENABLED=true
CHUNKING_PROFILE_VERSION=code-rag-v1
CHUNKING_WORKER_COMMAND=node
CHUNKING_WORKER_SCRIPT=../chunker/dist/index.js
