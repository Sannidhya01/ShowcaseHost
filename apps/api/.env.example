GENERATION_REQUEST_TIMEOUT_SECONDS=60
GENERATION_MAX_RETRIES=2
GENERATION_MAX_COMPLETION_TOKENS=4096
CHAT_RETRIEVAL_LIMIT=5
# Minimum normalized cross-encoder score; calibrate with the configured reranker.
CHAT_RELEVANCE_THRESHOLD=0.00017189
CHAT_RELATIVE_RELEVANCE_THRESHOLD=0.855
CHAT_RETRIEVAL_CANDIDATE_LIMIT=32
CHAT_RERANK_CANDIDATE_LIMIT=20
CHAT_RRF_K=60
CHAT_DENSE_WEIGHT=1.0
CHAT_KEYWORD_WEIGHT=1.0
CHAT_KEYWORD_METADATA_BOOST=2.0
CHAT_QUESTION_MAX_CHARS=4000
CHAT_HISTORY_MAX_MESSAGES=12
CHAT_PROMPT_MAX_CHARS=60000
EVALUATION_ENABLED=false
EVALUATION_RESULTS_ROOT=.data/evaluations
EVALUATION_HF_API_URL=https://datasets-server.huggingface.co
EVALUATION_DATASET_TIMEOUT_SECONDS=60
EVALUATION_MAX_EXAMPLES=100
EVALUATION_MAX_CONCURRENCY=8
