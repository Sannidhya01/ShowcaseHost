CHUNKING_SAFETY_MARGIN_RATIO=0.10
CHUNKING_POLL_SECONDS=1.0
CHUNKING_LEASE_SECONDS=300
CHUNKING_MAX_ATTEMPTS=3
GROQ_API_KEY=
GENERATION_PROVIDER=openrouter
